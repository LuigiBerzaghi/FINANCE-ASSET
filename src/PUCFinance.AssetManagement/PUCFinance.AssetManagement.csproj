<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PUCFinance.AssetManagement</RootNamespace>
    <!-- Coletor de lixo de estacao de trabalho: o de servidor (padrao do ASP.NET) segura memoria por nucleo e,
         sem enxergar o limite do dyno, passava dos 512 MB do Heroku Basic com os dados da CVM carregados -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    
    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    
    <!-- Excel export -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    
    <!-- Scheduling (para batch jobs se rodar local) -->
    <PackageReference Include="Cronos" Version="0.8.4" />
  </ItemGroup>

</Project>
